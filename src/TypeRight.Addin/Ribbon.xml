<?xml version="1.0" encoding="utf-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnRibbonLoad">
  <ribbon>
    <tabs>
      <tab id="tabTypeRight" label="TypeRight">
        <group id="grpMain" label="指认式批量排版">
          <button id="btnSimilar" size="large" label="同类选择"
                  screentip="选中与当前段落格式相同的所有段落"
                  supertip="光标点进一个段落后点击：全文档同款格式的段落一起选中，&#10;在浮动条上选字体即可批量修改。&#10;右键菜单里也有同名命令。"
                  imageMso="SelectSimilarFormats"
                  onAction="OnSimilar" />
          <button id="btnFormulas" size="large" label="公式转换"
                  screentip="全文纯文本公式 → Word 公式对象"
                  supertip="ax²+bx+c=0 这类文本公式批量转为可编辑公式对象，&#10;失败片段原样保留。"
                  imageMso="AutoSum"
                  onAction="OnFormulas" />
        </group>
        <group id="grpProfile" label="方案">
          <button id="btnProfiles" size="large" label="方案"
                  screentip="存为方案 / 应用 / 管理"
                  supertip="把这次的批量操作存成方案，下一份同类文档一键完成。"
                  imageMso="FileSaveAs"
                  onAction="OnProfiles" />
        </group>
      </tab>
    </tabs>
  </ribbon>
  <contextMenus>
    <contextMenu idMso="ContextMenuText">
      <button id="ctxSimilar" label="同类选择" onAction="OnSimilar"
              insertBeforeMso="Cut" imageMso="SelectSimilarFormats" />
    </contextMenu>
  </contextMenus>
</customUI>
