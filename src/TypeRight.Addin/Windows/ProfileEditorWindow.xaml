<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TypeRight.Addin.Windows.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TypeRight 方案管理" Width="780" Height="560"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：方案列表 -->
        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Text="方案列表" FontWeight="Bold" Margin="0,0,0,6" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="基于内置方案新建…" Padding="4" Margin="0,0,0,4" Click="OnDuplicate" />
                <Button Content="导入 JSON…" Padding="4" Margin="0,0,0,4" Click="OnImport" />
                <Button Content="导出 JSON…" Padding="4" Margin="0,0,0,4" Click="OnExport" />
                <Button Content="删除所选方案" Padding="4" Click="OnDelete" />
            </StackPanel>
            <ListBox x:Name="LstProfiles" SelectionChanged="OnProfileSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Profile.Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Profile.Id}" FontSize="11" Opacity="0.6" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 右：编辑器 -->
        <DockPanel Grid.Row="0" Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="名称：" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" x:Name="TxtName" Padding="2" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="2" Text="id：" VerticalAlignment="Center" />
                    <TextBox Grid.Column="3" x:Name="TxtId" Padding="2" />
                </Grid>
                <TextBox x:Name="TxtDescription" Padding="2" Margin="0,4,0,0" FontSize="11" />
            </StackPanel>
            <DataGrid x:Name="GridRoles" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="角色键" Binding="{Binding Key}" IsReadOnly="True" Width="88" />
                    <DataGridTextColumn Header="中文字体" Binding="{Binding Value.EastAsiaFont, UpdateSourceTrigger=PropertyChanged}" Width="88" />
                    <DataGridTextColumn Header="西文字体" Binding="{Binding Value.LatinFont, UpdateSourceTrigger=PropertyChanged}" Width="106" />
                    <DataGridTextColumn Header="字号pt" Binding="{Binding Value.SizePtText, UpdateSourceTrigger=PropertyChanged}" Width="56" />
                    <DataGridTextColumn Header="加粗(0/1)" Binding="{Binding Value.BoldText, UpdateSourceTrigger=PropertyChanged}" Width="62" />
                    <DataGridTextColumn Header="颜色" Binding="{Binding Value.Color, UpdateSourceTrigger=PropertyChanged}" Width="64" />
                    <DataGridTextColumn Header="对齐" Binding="{Binding Value.Alignment, UpdateSourceTrigger=PropertyChanged}" Width="52" />
                    <DataGridTextColumn Header="Word样式" Binding="{Binding Value.WordStyle, UpdateSourceTrigger=PropertyChanged}" Width="106" />
                    <DataGridTextColumn Header="行距" Binding="{Binding Value.LineSpacingText, UpdateSourceTrigger=PropertyChanged}" Width="46" />
                    <DataGridTextColumn Header="首行缩进pt" Binding="{Binding Value.FirstLineIndentPtText, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- 底部：保存 -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11"
                       Foreground="#2F855A" />
            <Button Content="保存所选方案" Padding="14,3" Margin="0,0,8,0" Click="OnSave" />
            <Button Content="关闭" Padding="12,3" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
