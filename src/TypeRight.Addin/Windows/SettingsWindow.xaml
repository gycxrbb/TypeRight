<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TypeRight.Addin.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TypeRight 设置" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="LLM 增强（可选）" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Text="默认关闭：关闭时全流程无网络请求。开启后仅把低置信段落（序号+前 50 字+特征）发给下方接口；API Key 只发往你配置的地址。"
                   FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,8" />
        <CheckBox x:Name="ChkEnabled" Content="启用 LLM 增强识别" Margin="0,0,0,8" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Base URL" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtBaseUrl" Margin="0,4" Padding="2"
                     Text="https://api.openai.com/v1" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="API Key" VerticalAlignment="Center" />
            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="TxtApiKey" Margin="0,4" Padding="2" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="模型名" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtModel" Margin="0,4" Padding="2" Text="gpt-4o-mini" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="超时（秒）" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtTimeout" Margin="0,4" Padding="2" Text="30" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="测试连接" Padding="10,2" Margin="0,0,8,0" Click="OnTest" />
            <TextBlock x:Name="TxtTestResult" VerticalAlignment="Center" FontSize="11" Foreground="#2F855A" />
        </StackPanel>

        <Separator Margin="0,12,0,12" />
        <TextBlock Text="排版默认选项" FontWeight="Bold" Margin="0,0,0,4" />
        <CheckBox x:Name="ChkMountStyles" Content="预览中默认勾选“同时挂载 Word 样式”" Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保存" Padding="16,3" Margin="0,0,8,0" Click="OnSave" IsDefault="True" />
            <Button Content="取消" Padding="12,3" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
