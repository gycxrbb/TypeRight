<Window x:Class="TypeRight.Addin.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TypeRight 设置" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock Text="设置（仅三项）" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
        <TextBlock Text="改动即时生效的项在保存后应用。" FontSize="11" Foreground="#6B7280" Margin="0,0,0,12" />

        <CheckBox x:Name="ChkLinkage" FontSize="12.5" Margin="0,0,0,4">
            <TextBlock Text="选中文体时自动联动西文字体（P0-3 规范兜底）" TextWrapping="Wrap"/>
        </CheckBox>
        <StackPanel Orientation="Horizontal" Margin="20,2,0,10">
            <TextBlock Text="默认西文字体" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#6B7280"/>
            <TextBox x:Name="TxtLatin" Width="180" Padding="3,2,3,2" Text="Times New Roman"/>
        </StackPanel>

        <CheckBox x:Name="ChkStrict" FontSize="12.5" Margin="0,0,0,12">
            <TextBlock Text="同类选择默认严格匹配（逐项勾选宽松更直观，不建议默认开）" TextWrapping="Wrap"/>
        </CheckBox>

        <TextBlock Text="方案存储目录" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtProfilesDir" Padding="3,2,3,2" IsReadOnly="False"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保存" Padding="16,3" Margin="0,0,8,0" Click="OnSave" IsDefault="True"/>
            <Button Content="取消" Padding="12,3" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
