<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TypeRight.Addin.UI.FloatBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TypeRight" Width="622" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="True"
        Topmost="False" AllowsTransparency="True" Background="Transparent"
        Focusable="False" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- 深色默认值（ShowBar 时按宿主 Word 实测主题覆盖；全部控件经 DynamicResource 取色） -->
        <SolidColorBrush x:Key="PanelBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#626262"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8B8B8"/>
        <SolidColorBrush x:Key="InputBgBrush" Color="#333333"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#6E6E6E"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#3D3D3D"/>
        <SolidColorBrush x:Key="PressedBrush" Color="#484848"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4D8EF7"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#6BA3FF"/>
        <SolidColorBrush x:Key="PopupBgBrush" Color="#2F2F2F"/>
        <SolidColorBrush x:Key="PopupBorderBrush" Color="#626262"/>
        <SolidColorBrush x:Key="ItemHoverBrush" Color="#3D3D3D"/>
        <SolidColorBrush x:Key="SeparatorBrush" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="DisabledBrush" Color="#808080"/>

        <!-- 下拉框：深色底 + 细边框 + 小箭头（贴近 Word 原生字体工具组） -->
        <Style x:Key="TyCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{DynamicResource InputBgBrush}"
                                          BorderBrush="{DynamicResource InputBorderBrush}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2">
                                            <Path x:Name="arrow" Data="M0,0 L4,4 8,0" Stretch="None"
                                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0.5,8,0.5"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PressedBrush}"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,0,24,0" VerticalAlignment="Center"
                                              TextBlock.Foreground="{DynamicResource TextBrush}"/>
                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False">
                                <Border Background="{DynamicResource PopupBgBrush}"
                                        BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1"
                                        CornerRadius="2" Margin="0,2,10,10" MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="7" ShadowDepth="2" Opacity="0.3"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ItemsPresenter Margin="2"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource DisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" CornerRadius="2" Margin="1,0.5" Padding="8,5" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 方形紧凑复选框：选中用 Office 蓝 -->
        <Style x:Key="TyCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid VerticalAlignment="Center">
                                <Border x:Name="box" Width="14" Height="14" CornerRadius="2"
                                        Background="{DynamicResource InputBgBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"/>
                                <Path x:Name="check" Data="M3.2,7.4 L6,10.2 L11,3.8" Visibility="Collapsed"
                                      Stroke="#FFFFFF" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashCap="Round"/>
                            </Grid>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="check" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 工具按钮（加粗 B）：小原生样式，含正常/悬停/按下/选中 -->
        <Style x:Key="TyToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 普通小按钮（关闭 ✕ / 颜色 A）：透明底 + 悬停高亮 -->
        <Style x:Key="TyPlain" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource PanelBrush}" CornerRadius="3"
            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
            Margin="5,5,5,7" MouseLeftButtonDown="OnBarDragMove">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
        </Border.Effect>
        <StackPanel Margin="12,9,12,9">

            <!-- 第 1 行：匹配结果（左） + 关闭（右）。整行可拖动悬浮条 -->
            <Grid Cursor="SizeAll">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⠿" FontFamily="Segoe UI Symbol" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="TxtCount" Text="已匹配 N 段" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="BtnClose" Style="{StaticResource TyPlain}" Content="✕" FontSize="10.5"
                        Width="22" Height="22" Click="OnClose" ToolTip="关闭 (Esc)"
                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Separator Background="{DynamicResource SeparatorBrush}" Height="1" Margin="0,8,0,8"/>

            <!-- 第 2 行：中文 [字体▾]  字号 [A⁻][当前值▾][A⁺]  B I U S  A颜色▾（对齐 Word"开始"字体组） -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="中文" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="CboFont" Style="{StaticResource TyCombo}" MinWidth="180"
                          SelectionChanged="OnFontSelected" VerticalAlignment="Center"/>
                <TextBlock Text="字号" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="10,0,6,0"/>
                <Button x:Name="BtnSizeDown" Style="{StaticResource TyPlain}" Content="A⁻" FontSize="11"
                        Width="26" Height="28" Click="OnSizeDown" ToolTip="减小字号" VerticalAlignment="Center"/>
                <Button x:Name="BtnSize" Style="{StaticResource TyPlain}" Width="56" Height="28" Margin="2,0,2,0"
                        Click="OnSizePopup" ToolTip="选择字号" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtSize" Text="—" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <Path Data="M0,0 L3.5,3.5 7,0" Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="1.4" Margin="7,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnSizeUp" Style="{StaticResource TyPlain}" Content="A⁺" FontSize="11"
                        Width="26" Height="28" Click="OnSizeUp" ToolTip="增大字号" VerticalAlignment="Center"/>
                <ToggleButton x:Name="BtnBold" Style="{StaticResource TyToggle}" Content="B"
                              FontSize="13" FontWeight="Bold" Width="30" Height="28"
                              Margin="10,0,0,0" Click="OnBoldToggled" VerticalAlignment="Center"/>
                <ToggleButton x:Name="BtnItalic" Style="{StaticResource TyToggle}" Width="30" Height="28"
                              Margin="4,0,0,0" Click="OnItalicToggled" ToolTip="斜体" VerticalAlignment="Center">
                    <TextBlock Text="I" FontSize="13" FontStyle="Italic" FontWeight="SemiBold"/>
                </ToggleButton>
                <ToggleButton x:Name="BtnUnderline" Style="{StaticResource TyToggle}" Width="30" Height="28"
                              Margin="4,0,0,0" Click="OnUnderlineToggled" ToolTip="下划线" VerticalAlignment="Center">
                    <TextBlock Text="U" FontSize="13" FontWeight="SemiBold" TextDecorations="Underline"/>
                </ToggleButton>
                <ToggleButton x:Name="BtnStrike" Style="{StaticResource TyToggle}" Width="30" Height="28"
                              Margin="4,0,0,0" Click="OnStrikeToggled" ToolTip="删除线" VerticalAlignment="Center">
                    <TextBlock Text="S" FontSize="13" FontWeight="SemiBold" TextDecorations="Strikethrough"/>
                </ToggleButton>
                <Button x:Name="BtnColor" Style="{StaticResource TyPlain}" Width="40" Height="28"
                        Margin="6,0,0,0" Click="OnColorClick" ToolTip="字体颜色" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Grid VerticalAlignment="Center" Margin="2,0,0,0" Width="14">
                            <TextBlock Text="A" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                            <Border x:Name="ColorStrip" Height="3" Width="14" CornerRadius="1"
                                    Background="#000000" BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                        </Grid>
                        <Path Data="M0,0 L3.5,3.5 7,0" Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="1.4" Margin="5,4,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Separator Background="{DynamicResource SeparatorBrush}" Height="1" Margin="0,9,0,7"/>

            <!-- 第 3 行：匹配条件 -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="匹配:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <CheckBox x:Name="ChkStrict" Style="{StaticResource TyCheck}" Content="严格" IsChecked="True"
                          Checked="OnStrictChanged" Unchecked="OnStrictChanged" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkIgnoreSize" Style="{StaticResource TyCheck}" Content="忽略字号" Margin="12,0,0,0"
                          IsEnabled="False" Checked="OnIgnoreToggled" Unchecked="OnIgnoreToggled" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkIgnoreColor" Style="{StaticResource TyCheck}" Content="忽略颜色" Margin="10,0,0,0"
                          IsEnabled="False" Checked="OnIgnoreToggled" Unchecked="OnIgnoreToggled" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkIgnoreBold" Style="{StaticResource TyCheck}" Content="忽略加粗" Margin="10,0,0,0"
                          IsEnabled="False" Checked="OnIgnoreToggled" Unchecked="OnIgnoreToggled" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 第 4 行：底部提示（左：西文联动；右：Esc） -->
            <Grid Margin="0,8,0,0">
                <TextBlock x:Name="TxtHint" Text="西文自动联动 Times New Roman" FontSize="10.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                <TextBlock Text="Esc 关闭" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
