<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TypeRight.Addin.UI.FloatBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TypeRight" Width="436" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="True"
        Topmost="False" AllowsTransparency="True" Background="Transparent"
        Focusable="False"
        TextOptions.TextFormattingMode="Display">
    <Border Background="#FFFFFF" CornerRadius="10" BorderBrush="#C9D2E3" BorderThickness="1"
            Margin="8,8,8,10" MouseLeftButtonDown="OnBarDragMove">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.28" />
        </Border.Effect>
        <StackPanel Margin="14,10,14,12">

            <!-- 顶行：拖动把手 + 匹配计数 + 关闭（把手区可拖动整个浮条） -->
            <Grid Cursor="SizeAll" ToolTip="按住可拖动">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⠿" FontFamily="Segoe UI Symbol" FontSize="13" Foreground="#B8BFCB"
                               VerticalAlignment="Center" Margin="0,0,7,0" />
                    <Ellipse Width="9" Height="9" Fill="#2B5CB8" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="TxtCount" Text="已匹配 N 段" FontSize="13.5" FontWeight="Bold"
                               Foreground="#1F2329" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtPerf" FontSize="10.5" Foreground="#9CA3AF" VerticalAlignment="Center"
                               Margin="8,1,0,0" />
                </StackPanel>
                <Button x:Name="BtnClose" HorizontalAlignment="Right" Content="✕" FontSize="11" Width="22" Height="22"
                        Background="Transparent" BorderThickness="0" Foreground="#6B7280" Cursor="Hand"
                        Click="OnClose" VerticalAlignment="Center" />
            </Grid>

            <Separator Background="#EDF0F5" Margin="0,8,0,8" Height="1" />

            <!-- 格式行 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="中文" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Grid.Column="1" x:Name="CboFont" MinWidth="130" FontSize="12.5"
                          SelectionChanged="OnFontSelected" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="字号" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox Grid.Column="3" x:Name="CboSize" Width="72" FontSize="12.5"
                          SelectionChanged="OnSizeSelected" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="4" x:Name="BtnBold" Content="B" FontSize="13" FontWeight="Bold" Width="30"
                              Height="26" Margin="10,0,0,0" Click="OnBoldToggled" Cursor="Hand" />
                <Button Grid.Column="5" x:Name="BtnColor" Content="🎨" FontSize="12" Width="34" Height="26"
                        Margin="6,0,0,0" Click="OnColorClick" Cursor="Hand" ToolTip="颜色" />
                <TextBlock Grid.Column="6" x:Name="TxtHint" Text="西文自动 Times New Roman" FontSize="10"
                           Foreground="#9CA3AF" VerticalAlignment="Center" Margin="10,2,0,0" />
            </Grid>

            <!-- 匹配选项行 -->
            <Separator Background="#EDF0F5" Margin="0,9,0,7" Height="1" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="匹配:" FontSize="11.5" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0" />
                <CheckBox x:Name="ChkStrict" Content="严格" FontSize="11.5" IsChecked="True"
                          Checked="OnStrictChanged" Unchecked="OnStrictChanged" VerticalAlignment="Center" />
                <CheckBox x:Name="ChkIgnoreSize" Content="忽略字号" FontSize="11.5" Margin="12,0,0,0" IsEnabled="False"
                          Checked="OnIgnoreToggled" Unchecked="OnIgnoreToggled" VerticalAlignment="Center" />
                <CheckBox x:Name="ChkIgnoreColor" Content="忽略颜色" FontSize="11.5" Margin="10,0,0,0" IsEnabled="False"
                          Checked="OnIgnoreToggled" Unchecked="OnIgnoreToggled" VerticalAlignment="Center" />
                <CheckBox x:Name="ChkIgnoreBold" Content="忽略加粗" FontSize="11.5" Margin="10,0,0,0" IsEnabled="False"
                          Checked="OnIgnoreToggled" Unchecked="OnIgnoreToggled" VerticalAlignment="Center" />
                <TextBlock Text="Esc 关闭" FontSize="10" Foreground="#B8BFCB" VerticalAlignment="Center" Margin="12,1,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
