<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="TypeRight.Addin.Panes.PreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TypeRight.Addin.Panes"
             xmlns:roles="clr-namespace:TypeRight.Roles;assembly=TypeRight.Core"
             Focusable="False">
    <UserControl.Resources>
        <local:RoleLabelConverter x:Key="RoleLabel" />
        <Style x:Key="RowTextStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="8">
        <!-- 顶部：方案选择 -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="方案：" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Grid.Column="1" x:Name="CboProfile"
                          ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                          DisplayMemberPath="Name" />
                <Button Grid.Column="2" Content="重新扫描" Margin="6,0,0,0" Padding="8,2"
                        Command="{Binding RescanCommand}" ToolTip="重新扫描并识别当前文档" />
            </Grid>
            <TextBlock Text="{Binding ProfileDescription}" FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- 统计 -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDD" BorderThickness="0,0,0,1" Margin="0,0,0,6">
            <TextBlock Text="{Binding SummaryText}" FontSize="12" LineHeight="19" TextWrapping="Wrap" />
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="{Binding NoteText}" FontSize="11" Foreground="#B45309"
                   TextWrapping="Wrap" Margin="0,0,0,6" />

        <!-- 底部：选项与按钮 -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,6,0,0">
            <StackPanel>
                <CheckBox Content="同时挂载 Word 样式（治本：改动写入样式定义）" IsChecked="{Binding MountStyles}"
                          Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.6"
                               Text="应用后一次 Ctrl+Z 可完全撤销" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="应用排版" Padding="16,4" Margin="0,0,8,0"
                            Command="{Binding ApplyCommand}" />
                    <Button Grid.Column="2" Content="取消" Padding="12,4" Command="{Binding HideCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 过滤条 -->
        <DockPanel DockPanel.Dock="Top">
            <CheckBox Content="仅显示低置信段落" IsChecked="{Binding ShowOnlyLowConfidence}" Margin="0,0,0,4"
                      DockPanel.Dock="Left" />
            <TextBlock Text="{Binding ModeText}" FontWeight="Bold" Foreground="#1A365D"
                       HorizontalAlignment="Right" />
        </DockPanel>

        <!-- 逐段清单（虚拟化） -->
        <ListView ItemsSource="{Binding Rows}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  AlternationCount="2">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LowConfidence}" Value="True">
                            <Setter Property="Background" Value="#FFF7ED" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="段落" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Preview}" Style="{StaticResource RowTextStyle}"
                                           ToolTip="{Binding Preview}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="角色" Width="105">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{x:Static local:ParagraphRowVM.RoleChoices}"
                                          SelectedItem="{Binding Role, Mode=TwoWay}"
                                          FontSize="12">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource RoleLabel}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="依据" Width="44">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RuleLabel}" FontSize="11" Opacity="0.6" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
