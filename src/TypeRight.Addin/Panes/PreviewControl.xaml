<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="TypeRight.Addin.Panes.PreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TypeRight.Addin.Panes"
             Focusable="False"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <local:RoleLabelConverter x:Key="RoleLabel" />
        <local:PageToVisibilityConverter x:Key="PageVis" />
        <local:ConfidenceBrushConverter x:Key="ConfBrush" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <SolidColorBrush x:Key="Accent" Color="#2B5CB8" />
        <SolidColorBrush x:Key="AccentHover" Color="#1E48A0" />
        <SolidColorBrush x:Key="PageBg" Color="#F7F8FA" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E5E8EE" />
        <SolidColorBrush x:Key="TextMain" Color="#1F2329" />
        <SolidColorBrush x:Key="TextSub" Color="#6B7280" />

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#C3CADB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#2B5CB8" />
            <Setter Property="BorderBrush" Value="#2B5CB8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF4FE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#2B5CB8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="#2B5CB8" TextDecorations="Underline">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#1E48A0" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepDone" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2F855A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="StepCurrent" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2B5CB8" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="StepTodo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBg}">

        <!-- ═══════════ 欢迎页 ═══════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Welcome}">
            <StackPanel Margin="28,36,28,24" MaxWidth="420" HorizontalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="28" Background="#EAF0FC" HorizontalAlignment="Center">
                    <TextBlock Text="✦" FontSize="26" Foreground="#2B5CB8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="TypeRight 智能排版" FontSize="20" FontWeight="Bold" Foreground="#1F2329"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Text="自动识别标题、正文、图注与公式，&#xA;按学术规范一键重排整篇文档。" FontSize="13" Foreground="#6B7280"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,28" />

                <Button Style="{StaticResource BtnPrimary}" Command="{Binding ScanNowCommand}" Margin="0,0,0,10"
                        IsEnabled="{Binding CanScanCurrent}" Content="① 扫描当前文档" />
                <Button Style="{StaticResource BtnSecondary}" Command="{Binding CreateSampleCommand}"
                        Content="生成示例文档，先试一试" />

                <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" Padding="16" Margin="0,28,0,0">
                    <StackPanel>
                        <TextBlock Text="三步完成" FontWeight="SemiBold" FontSize="13" Foreground="#1F2329" Margin="0,0,0,8" />
                        <TextBlock FontSize="12" Foreground="#6B7280" LineHeight="22">
                            <Run Text="1. 扫描并识别每一段的角色（标题 / 正文 / 图注…）" />
                            <LineBreak />
                            <Run Text="2. 在清单里核对，不确定的段落可手动改" />
                            <LineBreak />
                            <Run Text="3. 一键应用，中西文字体、样式、公式全部就位" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Text="🛡 所有改动打包成一次撤销：Ctrl+Z 即可完全还原，原文档结构（表格、图片、批注）不受影响。"
                           FontSize="11.5" Foreground="#8A94A6" TextWrapping="Wrap" Margin="4,14,4,0" TextAlignment="Center" />
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════ 确认页 ═══════════ -->
        <Grid Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Preview}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 头部：文档 + 步骤 -->
            <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1" Padding="14,10,14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding DocName}" FontSize="12" Foreground="#6B7280" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource StepDone}" Text="① 扫描完成" />
                            <TextBlock Style="{StaticResource StepTodo}" Text="  →  " />
                            <TextBlock Style="{StaticResource StepCurrent}" Text="② 确认角色" />
                            <TextBlock Style="{StaticResource StepTodo}" Text="  →  ③ 应用" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BtnLink}" Content="示例文档" Command="{Binding CreateSampleCommand}"
                                Margin="0,0,10,0" ToolTip="生成一份带“脏”格式的示例讲义，零风险体验完整流程" />
                        <Button Style="{StaticResource BtnLink}" Content="重新扫描"
                                Command="{Binding RescanCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 方案选择 -->
            <Grid Grid.Row="1" Margin="14,10,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="排版方案" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                          DisplayMemberPath="Name" ToolTip="{Binding ProfileDescription}" />
            </Grid>
            <TextBlock Grid.Row="2" Text="{Binding ProfileDescription}" FontSize="11" Foreground="#8A94A6"
                       Margin="14,0,14,8" TextTrimming="CharacterEllipsis" />

            <!-- 统计 chips -->
            <Border Grid.Row="3" Background="{StaticResource CardBg}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1" Padding="10,8" Margin="0,2,0,0">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Chips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F2F4F8" CornerRadius="10" Padding="8,3" Margin="0,0,6,4"
                                        ToolTip="{Binding ToolTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{Binding Dot}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock FontSize="11.5" Foreground="#3D4451" VerticalAlignment="Center">
                                            <Run Text="{Binding Label, Mode=OneWay}" />
                                            <Run Text="{Binding Count, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ScanMeta}" FontSize="10.5" Foreground="#9CA3AF" Margin="2,3,0,0" />
                </StackPanel>
            </Border>

            <!-- 段落清单 -->
            <Grid Grid.Row="4" Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="10,0,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="TxtSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 VerticalContentAlignment="Center" Padding="8,5" />
                        <TextBlock Text="🔍 搜索段落文字" IsHitTestVisible="False" Foreground="#9CA3AF"
                                   VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <CheckBox Grid.Column="1" Content="{Binding LowConfidenceText}" IsChecked="{Binding ShowOnlyLowConfidence}"
                              Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="#B45309"
                              ToolTip="橙色“推测”行为按格式聚类猜测的角色，建议优先核对" />
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{Binding Rows}" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          Padding="4,0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="Margin" Value="6,1" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#EDF1F8" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding LowConfidence}" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#FFF6E9" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Index, StringFormat='¶{0}'}" FontSize="10.5" Foreground="#9CA3AF"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Preview}" Style="{StaticResource RowText}"
                                               FontSize="12" ToolTip="{Binding Preview}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox ItemsSource="{x:Static local:ParagraphRowVM.RoleChoices}"
                                              SelectedItem="{Binding Role, Mode=TwoWay}" FontSize="11.5" MinWidth="86"
                                              VerticalAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource RoleLabel}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Border CornerRadius="8" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                            Background="{Binding ConfidenceKind, Converter={StaticResource ConfBrush}}"
                                            ToolTip="{Binding ConfidenceTip}">
                                        <TextBlock Text="{Binding ConfidenceLabel}" FontSize="10" Foreground="White" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- 底部操作区 -->
            <Border Grid.Row="5" Background="{StaticResource CardBg}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1,0,0" Padding="14,10,14,12">
                <StackPanel>
                    <TextBlock Text="{Binding NoteText}" FontSize="11" Foreground="#B45309" TextWrapping="Wrap"
                               Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox Content="挂载 Word 样式（治本）" IsChecked="{Binding MountStyles}" FontSize="11.5"
                                  Margin="0,0,14,0" ToolTip="把格式写入 Word 样式定义：后续新增段落自动跟随，可随时在样式中微调" />
                        <CheckBox Content="转换纯文本公式" IsChecked="{Binding ConvertFormulas}" FontSize="11.5"
                                  ToolTip="把 ax²+bx+c=0 这类文本转为可编辑的 Word 公式对象" />
                    </StackPanel>
                    <Button Style="{StaticResource BtnPrimary}" Command="{Binding ApplyCommand}" Content="③ 应用排版" />
                    <TextBlock Text="🛡 一次 Ctrl+Z 即可完全撤销本次改动" FontSize="10.5" Foreground="#8A94A6"
                               HorizontalAlignment="Center" Margin="0,7,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ 结果页 ═══════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Result}">
            <StackPanel Margin="28,40,28,24" MaxWidth="420" HorizontalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#E6F4EA" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultOk}" Value="False">
                                    <Setter Property="Background" Value="#FDECEA" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="✔" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#2F855A" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultOk}" Value="False">
                                        <Setter Property="Foreground" Value="#C0392B" />
                                        <Setter Property="Text" Value="⚠" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <TextBlock FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="排版完成" />
                            <Setter Property="Foreground" Value="#1F2329" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultOk}" Value="False">
                                    <Setter Property="Text" Value="未执行" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding ResultLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12.5" Foreground="#3D4451" TextWrapping="Wrap"
                                       Margin="0,3" HorizontalAlignment="Center" TextAlignment="Center" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Style="{StaticResource BtnPrimary}" Command="{Binding RescanCommand}" Margin="0,26,0,10"
                        Content="重新扫描检查" />
                <Button Style="{StaticResource BtnSecondary}" Command="{Binding FinishCommand}" Content="完成" />

                <TextBlock Text="🛡 本次改动已打包为一次撤销：按 Ctrl+Z 即可完全还原" FontSize="11" Foreground="#8A94A6"
                           HorizontalAlignment="Center" Margin="0,16,0,0" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
